DZMM_DATABASE_URL=postgresql+psycopg://dzmm:CHANGE_ME@127.0.0.1/dzmm
DZMM_CORE_TOKEN=CHANGE_ME
DZMM_ADMIN_TOKEN=CHANGE_ME
DZMM_BROWSER_PROFILE=/var/lib/dzmm-browser/profile
DZMM_OUTBOUND_CONCURRENCY=4
