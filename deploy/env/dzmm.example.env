DZMM_DATABASE_URL=postgresql+psycopg://dzmm:CHANGE_ME@127.0.0.1/dzmm
DZMM_CORE_TOKEN=CHANGE_ME
DZMM_ADMIN_TOKEN=CHANGE_ME
DZMM_BROWSER_PROFILE=/var/lib/dzmm-browser/profile
DZMM_OUTBOUND_CONCURRENCY=4
DZMM_LOGIN_URL=CHANGE_ME
DZMM_CHAT_URL=CHANGE_ME
DZMM_MISTREALM_ENABLED=false
# Required to enable /象棋. The Gamefy card URL and API URL must use HTTPS.
DZMM_CHESS_GAME_ID=3761638
DZMM_CHESS_TOKEN_AUDIENCE=00400412-d145-4a78-848e-3962bc375891
# Temporary chess-only UID mode trusts caller-supplied identity. Keep false outside accepted-risk testing.
DZMM_CHESS_ALLOW_UID=false
DZMM_CHESS_GAME_URL=https://www.aikda.com/chat?card=3761638
DZMM_CHESS_PUBLIC_API_URL=https://49.234.20.159
DZMM_CHESS_TEST_CHATROOM_ID=c1f72c3c-409b-4c5a-be74-51370922a270
DZMM_DOUDIZHU_GAME_ID=
DZMM_DOUDIZHU_GAME_URL=
DZMM_DOUDIZHU_PUBLIC_API_URL=
DZMM_DOUDIZHU_CHATROOM_ID=
DZMM_DRAWGUESS_GAME_ID=
DZMM_DRAWGUESS_GAME_URL=
DZMM_DRAWGUESS_PUBLIC_API_URL=
DZMM_DRAWGUESS_CHATROOM_ID=
# Required to enable /club and /麻将 after creating the unified Gamefy card.
DZMM_CLUB_GAME_ID=3799452
DZMM_CLUB_GAME_URL=https://www.aikda.com/chat?card=3799452
DZMM_CLUB_PUBLIC_API_URL=https://49.234.20.159
DZMM_CLUB_CHATROOM_ID=4fc4a2fd-465a-4436-9884-dbb5e60c6af2
# Optional. Long group replies (over 1000 characters or 10 line breaks) use Bot API.
DZMM_BOT_API_TOKEN=
# Required for the group-chat "添加长消息 Bot" action.
DZMM_BOT_ID=
DP_API_KEY=CHANGE_ME
DZMM_DEEPSEEK_MODEL=deepseek-v4-flash
# Optional; leave at the official OpenAI-compatible endpoint unless instructed otherwise.
DZMM_DEEPSEEK_BASE_URL=https://api.deepseek.com
DZMM_WORKSTATION_PUBLIC_URL=
DZMM_GAMEFY_GAME_ID=
DZMM_WORKSTATION_GAME_URL=
# Build-time only; never put service/API credentials in the public game bundle.
# The public DNS name stays stable when moving to a different server IP.
DZMM_WORKSTATION_API_BASE_URL=https://workstation.example.com
DZMM_GAMEFY_CARD_ID=
# Caddy installer input; it writes a separate /etc/caddy/dzmm.env.
DZMM_PUBLIC_HOST=workstation.example.com
DZMM_ADMIN_WEB_PORT=18090
